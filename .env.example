# phantra-growth: every setting, by name, with EMPTY values. Copy to .env on
# the host that runs a bot and fill it in there; never commit the copy.
# (bots/discord/tests/test_looks.py checks the required names are here, empty.)

# --- Discord bot (bots/discord) -------------------------------------------
# The bot token from the Discord developer portal; the API it calls; and
# its Phantra sign-in, a plugin token from `python -m bots.discord pair`
# (revocable in the studio: Settings -> Connections).
DISCORD_BOT_TOKEN=
PHANTRA_API_BASE=
PHANTRA_BOT_API_KEY=
# PHANTRA_BOT_STATE_DIR=bots/state      # daily caps + welcomed members (SQLite)
# PHANTRA_BOT_DAILY_CAP=5               # free looks per person per UTC day
# PHANTRA_BOT_WELCOME_DM=1              # the ONE direct message, on join; 0 = none
# PHANTRA_OPEN_URL=https://phantra.ai/studio

# --- Reddit listener (bots/reddit_listener), READ-ONLY ----------------------
# A Reddit "script" app's id and secret (reddit.com/prefs/apps), the user
# agent Reddit asks for ("phantra-listener/0.1 by u/<you>"), and where alerts
# go: a Discord channel webhook, and/or SMTP for email. With neither, matches
# print to stdout.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=
REDDIT_ALERT_WEBHOOK_URL=
# REDDIT_SUBREDDITS=aivideo,VideoEditing,filmmakers,SaaS,SideProject,NewTubers
# REDDIT_INTENT_PHRASES=                # extra phrases, `|`-separated, added to the defaults
# REDDIT_ALERT_SMTP_HOST=
# REDDIT_ALERT_SMTP_PORT=587
# REDDIT_ALERT_SMTP_USER=
# REDDIT_ALERT_SMTP_PASSWORD=
# REDDIT_ALERT_FROM=
# REDDIT_ALERT_TO=
